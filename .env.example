# Neon Postgres Database Connection
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL="https://auth.neon.tech/..."
NEON_AUTH_JWKS_URL="https://auth.neon.tech/.../.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_ENDPOINT_URL_S3="https://storage.neon.tech/..."
AWS_REGION="us-east-2"
NEON_OBJECT_STORAGE_BUCKET="assets"

# Resend API Key for Email & SMS delivery
RESEND_API_KEY="re_123456789"

# Sender address (using your verified dish.place domain in Resend)
SENDER_EMAIL="water@dish.place"

NEXT_PUBLIC_APP_URL="https://water.dish.place"
